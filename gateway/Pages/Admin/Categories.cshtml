@page
@model gateway.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = "Category Manager";
    ViewData["ActivePage"] = "Categories";
}

<div class="page-intro">
    <p>Manage <strong>Product categories</strong> via the Product Service. Creating categories requires an Admin JWT token in the sidebar.</p>
</div>

<div class="content-grid">
    <!-- Create Category -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <div class="card-title-icon" style="background:var(--warning-dark);color:var(--warning);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                        <line x1="12" y1="11" x2="12" y2="17"/>
                        <line x1="9" y1="14" x2="15" y2="14"/>
                    </svg>
                </div>
                Create Category
            </div>
            <span class="badge badge-service">POST /api/categories</span>
        </div>

        <div class="alert alert-warning" style="margin-bottom:16px;font-size:12px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Requires <strong>Admin role</strong> JWT in the sidebar token panel.
        </div>

        <div class="form-group">
            <label class="form-label" for="cat-name">Category Name</label>
            <input id="cat-name" class="form-control" type="text" placeholder="e.g. Electronics" />
        </div>
        <div class="form-group">
            <label class="form-label" for="cat-description">Description</label>
            <textarea id="cat-description" class="form-control" rows="3" placeholder="Category description…"></textarea>
        </div>

        <button class="btn btn-primary btn-full" id="createCatBtn" onclick="doCreateCategory()">
            <div class="spinner"></div>
            <span class="btn-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Create Category
            </span>
        </button>

        <div class="divider"></div>

        <div id="createCatResult" class="result-box">
            // Response will appear here…
        </div>
    </div>

    <!-- List Categories -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <div class="card-title-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
                All Categories
            </div>
            <div style="display:flex;gap:8px;">
                <span class="badge badge-service">GET /api/categories</span>
                <button class="btn btn-sm btn-ghost" onclick="loadCategories()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;">
                        <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                    </svg>
                    Refresh
                </button>
            </div>
        </div>

        <div id="categoriesTableContainer">
            <p style="color:var(--text-muted);font-style:italic;padding:24px;text-align:center;">
                Click <strong>Refresh</strong> to load categories.
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function doCreateCategory() {
    const name        = document.getElementById('cat-name').value.trim();
    const description = document.getElementById('cat-description').value.trim();
    if (!name) { showToast('Category name is required.', 'error'); return; }

    setLoading('createCatBtn', true);
    showLoading('createCatResult', 'Creating category…');

    const { ok, data } = await apiCall('/api/categories', {
        method: 'POST',
        body: JSON.stringify({ name, description })
    });

    setLoading('createCatBtn', false);
    displayResult('createCatResult', data, ok);

    if (ok) {
        showToast('Category created successfully!', 'success');
        loadCategories();
    } else {
        showToast(data?.message || 'Failed to create category.', 'error');
    }
}

async function loadCategories() {
    document.getElementById('categoriesTableContainer').innerHTML =
        '<p style="color:var(--text-muted);font-style:italic;padding:24px;text-align:center;">Loading…</p>';

    const { ok, data } = await apiCall('/api/categories');

    if (ok && data?.data?.categories) {
        const cats = data.data.categories;
        if (cats.length === 0) {
            document.getElementById('categoriesTableContainer').innerHTML =
                '<p style="color:var(--text-muted);font-style:italic;padding:24px;text-align:center;">No categories yet.</p>';
        } else {
            renderTable('categoriesTableContainer', cats, ['id', 'name', 'description']);
        }
        showToast(`Loaded ${cats.length} categorie(s).`, 'success');
    } else {
        document.getElementById('categoriesTableContainer').innerHTML =
            `<p style="color:var(--danger);padding:16px;">${data?.message || 'Failed to load categories.'}</p>`;
        showToast(data?.message || 'Failed to load categories.', 'error');
    }
}

// Auto-load on page open
loadCategories();
</script>
}
