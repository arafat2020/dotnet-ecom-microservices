@page
@model gateway.Pages.Admin.ProductsModel
@{
    ViewData["Title"] = "Product Explorer";
    ViewData["ActivePage"] = "Products";
}

<div class="page-intro">
    <p>Search the <strong>Product Service</strong> catalog with full-text queries and paginated results.</p>
</div>

<div class="content-grid">
    <!-- Search Form -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <div class="card-title-icon" style="background:var(--success-dark);color:var(--success);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                Search Products
            </div>
            <span class="badge badge-service">GET /api/products/search</span>
        </div>

        <div class="form-group">
            <label class="form-label" for="search-query">Search Query</label>
            <input id="search-query" class="form-control" type="text" placeholder='e.g. "laptop", "shirt"…' />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="search-page">Page</label>
                <input id="search-page" class="form-control" type="number" value="1" min="1" />
            </div>
            <div class="form-group">
                <label class="form-label" for="search-size">Page Size</label>
                <input id="search-size" class="form-control" type="number" value="10" min="1" max="100" />
            </div>
        </div>

        <button class="btn btn-success btn-full" id="searchBtn" onclick="doSearch()">
            <div class="spinner"></div>
            <span class="btn-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                Search
            </span>
        </button>

        <div class="divider"></div>

        <div class="alert alert-info" style="font-size:12px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            This endpoint is public — no JWT token required.
        </div>
    </div>

    <!-- Raw Response -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">Raw Response</div>
            <button class="copy-btn" onclick="copyElement('searchResult', 'Response')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
            </button>
        </div>
        <div id="searchResult" class="result-box">
            // Response will appear here…
        </div>
    </div>
</div>

<!-- Results Table -->
<div class="card" style="margin-top:0;">
    <div class="card-header">
        <div class="card-title">
            <div class="card-title-icon" style="background:var(--success-dark);color:var(--success);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>
                </svg>
            </div>
            Results
        </div>
        <span id="searchCount" style="font-size:12px;color:var(--text-muted);"></span>
    </div>
    <div id="searchTableContainer">
        <p style="color:var(--text-muted);font-style:italic;padding:16px;text-align:center;">Run a search to see results here.</p>
    </div>
</div>

@section Scripts {
<script>
async function doSearch() {
    const query    = document.getElementById('search-query').value.trim();
    const page     = document.getElementById('search-page').value || 1;
    const pageSize = document.getElementById('search-size').value || 10;

    setLoading('searchBtn', true);
    showLoading('searchResult', 'Querying Product Service…');
    document.getElementById('searchTableContainer').innerHTML = '<p style="color:var(--text-muted);font-style:italic;padding:16px;text-align:center;">Loading…</p>';

    const url = `/api/products/search?query=${encodeURIComponent(query)}&page=${page}&pageSize=${pageSize}`;
    const { ok, data } = await apiCall(url);

    setLoading('searchBtn', false);
    displayResult('searchResult', data, ok);

    if (ok && data?.data?.products) {
        const products = data.data.products;
        document.getElementById('searchCount').textContent = `${products.length} result(s)`;
        if (products.length === 0) {
            document.getElementById('searchTableContainer').innerHTML =
                '<p style="color:var(--text-muted);font-style:italic;padding:24px;text-align:center;">No products found for that query.</p>';
        } else {
            renderTable('searchTableContainer', products, ['id', 'name', 'description', 'price', 'categoryId', 'imageUrl']);
        }
        showToast(`Found ${products.length} product(s).`, 'success');
    } else {
        document.getElementById('searchTableContainer').innerHTML =
            `<p style="color:var(--danger);padding:16px;">${data?.message || 'Search failed.'}</p>`;
        showToast(data?.message || 'Search failed.', 'error');
    }
}

// Allow Enter key in search box
document.getElementById('search-query').addEventListener('keydown', e => {
    if (e.key === 'Enter') doSearch();
});
</script>
}
