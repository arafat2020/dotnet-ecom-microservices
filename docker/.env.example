# Copy this file to docker/.env and fill in the values.

# ── SQL Server ─────────────────────────────────────────────────────────────────
SA_PASSWORD=

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Must be at least 32 characters long for HS256
JWT_KEY=

# ── Admin Seed Credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ecom.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── SuperAdmin Seed Credentials (required: the dashboard needs this role) ─────
SUPERADMIN_EMAIL=superadmin@ecom.local
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Set STRIPE_USE_MOCK=false and provide a real secret key to charge through Stripe
STRIPE_USE_MOCK=true
STRIPE_SECRET_KEY=
